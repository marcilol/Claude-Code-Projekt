## 0) Libraries
library(xts)
library(tidyquant)
library(tidyverse)
## 1) Set project root and source functions
setwd("~/Quantastic")   # adjust if needed
source("R/data_download.R")
source("R/factor_models.R")
source("R/risk_decomposition.R")
## 2) Load portfolio
portfolio <- load_portfolio_csv("portfolios/Own_Portfolio.csv")
## 3) Download stock & factor data (3y)
start_date <- Sys.Date() - 365*3
end_date   <- Sys.Date()
stock_returns <- download_stock_returns(
tickers    = portfolio$ticker,
start_date = start_date,
end_date   = end_date
)
factor_returns <- download_fama_french_factors(
start_date = start_date,
end_date   = end_date
)
aligned <- align_data(stock_returns, factor_returns)
stock_ret_aligned  <- aligned$stock_returns
factor_ret_aligned <- aligned$factor_returns
## 4) Estimate factor model per stock
factor_model <- estimate_factor_model(
stock_returns  = stock_ret_aligned,
factor_returns = factor_ret_aligned
)
beta_matrix <- factor_model$beta_matrix
sigma2_idio <- factor_model$sigma2_idio
## 5) Compute current value-based weights
prices <- portfolio$ticker %>%
tq_get(get = "stock.prices",
from = end_date - 10,
to   = end_date) %>%
group_by(symbol) %>%
slice_tail(n = 1) %>%
ungroup() %>%
select(ticker = symbol, date, price = adjusted)
portfolio_value <- calculate_weights(portfolio, prices)
## Match weights to stocks that have betas (drop failed tickers)
valid_tickers <- rownames(beta_matrix)
portfolio_clean <- portfolio_value %>%
filter(ticker %in% valid_tickers) %>%
mutate(weight = position_value / sum(position_value))
weights <- portfolio_clean$weight
names(weights) <- portfolio_clean$ticker
beta_matrix_clean <- beta_matrix[portfolio_clean$ticker, , drop = FALSE]
## 6) Run your existing risk decomposition
risk_decomp <- decompose_portfolio_risk(
weights       = weights,
beta_matrix   = beta_matrix_clean,
factor_returns = factor_ret_aligned,
sigma2_idio   = sigma2_idio[portfolio_clean$ticker],
annualize     = TRUE
)
## 7) Inspect key outputs
cat("\n=== PORTFOLIO RISK DECOMPOSITION (OWN_PORTFOLIO) ===\n")
cat("\nTotal annualized volatility:\n")
print(risk_decomp$vol_total)
cat("\nPercentage of risk from factors vs idiosyncratic:\n")
print(risk_decomp$pct_factor)       # % factor risk
print(risk_decomp$pct_idio)         # % idiosyncratic risk (if present in your object)
cat("\nPortfolio factor betas:\n")
print(round(risk_decomp$portfolio_betas, 3))
cat("\nFactor contributions to variance/volatility:\n")
print(risk_decomp$factor_contrib)   # name may differ slightly, check str(risk_decomp)
cat("\nStock-level contributions (if available):\n")
if (!is.null(risk_decomp$stock_contrib)) {
print(head(risk_decomp$stock_contrib))
}
cat("\nStock-level contributions (if available):\n")
## 0) Prep Environment
library(xts)
library(tidyquant)
library(tidyverse)
setwd("~/Quantastic")
source("R/data_download.R")
source("R/factor_models.R")
source("R/risk_decomposition.R")
## 1) Run existing analysis to get base data
# (Assuming aligned, factor_model, and weights are already in memory from previous run)
# Calculate Stock-Level Idiosyncratic Vol (Annualized)
idio_vols <- sqrt(factor_model$sigma2_idio) * sqrt(252)
## 2) Configuration Generator
# Config A: Current (weights already calculated)
# Config B: Risk Parity on Idiosyncratic Risk
# (Paleologo Ch 6: Sizing inversely proportional to idio vol)
weights_rp_idio <- (1/idio_vols) / sum(1/idio_vols)
# Config C: Market Beta Hedged (Naive)
# Reduces weights of highest beta stocks, increases lowest
mkt_betas <- factor_model$beta_matrix[, "Mkt.RF"]
weights_hedged <- weights * (1 / abs(mkt_betas))
weights_hedged <- weights_hedged / sum(weights_hedged)
## 3) Comparison Loop
configs <- list(
"Current" = weights,
"Idio Risk Parity" = weights_rp_idio,
"Mkt Beta Hedged" = weights_hedged
)
results_comp <- data.frame()
for(name in names(configs)) {
w <- configs[[name]]
rd <- decompose_portfolio_risk(
weights = w,
beta_matrix = factor_model$beta_matrix,
factor_returns = aligned$factor_returns,
sigma2_idio = factor_model$sigma2_idio
)
results_comp <- rbind(results_comp, data.frame(
Configuration = name,
Total_Vol = round(rd$vol_total * 100, 2),
Pct_Factor = round(rd$pct_factor, 2),
Pct_Idio = round(rd$pct_idio, 2),
Mkt_Beta = round(rd$portfolio_betas["Mkt.RF"], 3)
))
}
cat("\n=== PORTFOLIO CONFIGURATION COMPARISON ===\n")
print(results_comp)
