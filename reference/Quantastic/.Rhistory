## 0) Load all required libraries
library(xts)
library(tidyquant)
library(tidyverse)
## 1) Set project root and load your specific functions
# Ensure your current working directory is the project root
setwd("~/Quantastic")
source("R/data_download.R")
source("R/factor_models.R")
source("R/risk_decomposition.R")
## 2) Load your Own_Portfolio
portfolio <- load_portfolio_csv("portfolios/Own_Portfolio.csv")
## 3) Download stock and factor data (last 3 years)
start_date <- Sys.Date() - 365*3
end_date   <- Sys.Date()
stock_returns <- download_stock_returns(
tickers    = portfolio$ticker,
start_date = start_date,
end_date   = end_date
)
factor_returns <- download_fama_french_factors(
start_date = start_date,
end_date   = end_date
)
## 4) Align data and estimate factor model
aligned <- align_data(stock_returns, factor_returns)
factor_model <- estimate_factor_model(
stock_returns  = aligned$stock_returns,
factor_returns = aligned$factor_returns
)
## 5) Fetch latest prices for weighting
# Note: This handles potential download failures for individual tickers
prices <- portfolio$ticker %>%
tq_get(get = "stock.prices", from = end_date - 10, to = end_date) %>%
group_by(symbol) %>%
slice_tail(n = 1) %>%
ungroup() %>%
select(ticker = symbol, date, price = adjusted)
portfolio_value <- calculate_weights(portfolio, prices)
## 6) CRITICAL FIX: Match portfolio to successfully modeled tickers
# This prevents the "subscript out of bounds" error
valid_tickers <- rownames(factor_model$beta_matrix)
portfolio_clean <- portfolio_value %>%
filter(ticker %in% valid_tickers) %>%
mutate(weight = position_value / sum(position_value)) # Rescale weights to 1
weights <- portfolio_clean$weight
names(weights) <- portfolio_clean$ticker
## 7) Calculate Portfolio Factor Exposures (Betas)
beta_mat <- factor_model$beta_matrix[portfolio_clean$ticker, , drop = FALSE]
portfolio_betas <- as.numeric(crossprod(weights, beta_mat))
names(portfolio_betas) <- colnames(beta_mat)
cat("\n=== OWN_PORTFOLIO FACTOR EXPOSURES ===\n")
print(round(portfolio_betas, 3))
## 8) Correlation Matrix (Intra-portfolio)
# Using only valid tickers that have return data
cor_matrix <- cor(aligned$stock_returns[, portfolio_clean$ticker], use = "pairwise.complete.obs")
cat("\n=== INTRA-PORTFOLIO CORRELATION MATRIX ===\n")
print(round(cor_matrix, 2))
## 9) Identify High Correlation Redundancy (> 0.7)
high_cor <- which(abs(cor_matrix) > 0.7 & abs(cor_matrix) < 1, arr.ind = TRUE)
if(nrow(high_cor) > 0) {
cat("\n=== REDUNDANCY ALERT (Correlation > 0.7) ===\n")
printed_pairs <- c()
for(i in 1:nrow(high_cor)) {
pair <- sort(c(rownames(cor_matrix)[high_cor[i,1]], colnames(cor_matrix)[high_cor[i,2]]))
pair_string <- paste(pair, collapse="-")
if(!(pair_string %in% printed_pairs)) {
cat(pair[1], "and", pair[2], ":", round(cor_matrix[high_cor[i,1], high_cor[i,2]], 2), "\n")
printed_pairs <- c(printed_pairs, pair_string)
}
}
} else {
cat("\nNo significant stock-level redundancy detected.\n")
}
